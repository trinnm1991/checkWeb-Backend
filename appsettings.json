{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VisualMonitor": {
    "SiteKey": "tvu",
    "Name": "Đại học Trà Vinh",
    "Url": "https://www.tvu.edu.vn",
    "Enabled": false,
    "IntervalSeconds": 900,
    "CaptureOnStartup": false,
    "NavigationTimeoutMs": 60000,
    "RenderWaitMs": 3500,
    "ScreenshotRoot": "App_Data/captures",
    "SaveHistory": true,
    "HistoryRetentionDays": 3,
    "HistoryMaxItemsApi": 30
  },
  "SiteBuilder": {
    "Root": "App_Data/site-builder"
  },
  "Swagger": {
    "Enabled": true
  },
  "Urls": "http://127.0.0.1:5080"
}
